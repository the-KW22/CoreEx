# All server-side only: none of these reach the browser.
# Where the Spring Boot API listens.
API_URL=http://localhost:8080

# Supabase Auth, used for sign-in only. Local values come from `supabase status`
# (API URL and Publishable key). The publishable key is meant to be public; never use the secret key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_the_key_from_supabase_status
