# Copy to .env and export these before `./mvnw spring-boot:run` (README explains how).
# Defaults below are the fixed, public values of `supabase start` (local only).
DB_URL=jdbc:postgresql://localhost:54322/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Where Supabase Auth publishes the public keys that verify access tokens, and who must have issued them.
SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# The frontend origin(s) allowed to call the API from a browser, comma separated. Locally: the Next.js dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# This email becomes the first Admin on sign-in, with no Invite. Use the email you sign up with.
OWNER_EMAIL=owner@example.com

# Supabase Storage for Assets. Locally: the API URL from `supabase status` plus /storage/v1, and the Secret key
# (or service_role key) from `supabase status -o env`. The bucket `assets` comes from supabase/config.toml.
# Leave these empty to run without Assets: their endpoints then answer 503 and nothing else is affected.
STORAGE_URL=http://127.0.0.1:54321/storage/v1
STORAGE_SERVICE_KEY=replace_with_the_service_role_key_from_supabase_status
STORAGE_BUCKET=assets
